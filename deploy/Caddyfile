{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}

	reverse_proxy server:3000 {
		health_uri /health
		health_interval 10s
		health_timeout 2s
		health_status 200
	}
}